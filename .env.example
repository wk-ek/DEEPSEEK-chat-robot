# ============================================================
#  复制本文件为 .env，然后填入真实值。  .env 不会进版本库。
# ============================================================

# --- DeepSeek ---
# 在 https://platform.deepseek.com/api_keys 申请，形如 sk-xxxxxxxx
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 温度：0.6~1.1 之间比较像人。太高会胡说，太低会复读。
DEEPSEEK_TEMPERATURE=0.85

# --- OneBot / NapCat ---
# NapCat 里「WebSocket 服务器」监听的地址，一般就是下面这个
ONEBOT_WS_URL=ws://127.0.0.1:3001
# 如果你在 NapCat 里设了 Access Token，这里必须一致；没设就留空
ONEBOT_ACCESS_TOKEN=

# --- 模型提供方 ---
# deepseek = 真的调 API   |   mock = 本地假回复，用来跑通链路、不花钱
LLM_PROVIDER=deepseek

# --- 日志 ---
LOG_LEVEL=info
